PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# MongoDB Configuration
MONGODB_URI=mongodb://localhost:27017/codesync

# JWT Authentication
JWT_SECRET=super_secret_jwt_key_at_least_32_characters_long
JWT_EXPIRES_IN=7d
COOKIE_SECRET=super_secret_cookie_parser_signing_key

# Docker Execution
DOCKER_TIMEOUT_MS=10000
DOCKER_MEMORY_LIMIT=128m
DOCKER_CPU_LIMIT=0.5

# ─── AI Configuration ───────────────────────────────────────
# Option 1: Google Gemini (RECOMMENDED for deployment)
# Get your FREE API key at: https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.0-flash
AI_TIMEOUT_MS=30000

# Option 2: Ollama (for local development only)
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=codellama
